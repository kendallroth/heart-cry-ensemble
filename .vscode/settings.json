{
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  // Formatting on save does not conflict with ESLint "fix on save" since formatting rules are skipped.
  "editor.formatOnSave": true,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    ".env": ".env.*",
    ".prettierrc": ".prettierignore",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json"
  },
  // Explicitly ignore some Nuxt output directories as Git ignore files can be overridden if/when searching
  //   with a directory prefix.
  "search.exclude": {
    "**/.output": true,
    "**/.nuxt": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.rulers": [110]
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.rulers": [110]
  },
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.rulers": [110]
  }
}
